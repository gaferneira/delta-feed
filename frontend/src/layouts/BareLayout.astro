---
import BaseHead from './BaseHead.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'A quiet place for useful reading.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <main class="page-shell"><slot /></main>
  </body>
</html>
