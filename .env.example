# Local development settings. Copy to .env (gitignored) and adjust; scripts/dev.sh
# loads it. Plain KEY=value lines only. Variables already set in your shell win.

# --- Django -------------------------------------------------------------------
DJANGO_DEBUG=true
# Required whenever DJANGO_DEBUG is not true.
# DJANGO_SECRET_KEY=

# --- Attention budgets (ADR 0006) ---------------------------------------------
# BACKFILL_DAYS=30
# BACKFILL_MAX_ITEMS=20
# RSS_POLL_INTERVAL_MINUTES=30
# TODAY_BUDGET=12
# TODAY_PER_SOURCE_CAP=3
# MENTION_UNDO_SECONDS=20

# --- Model work (ADR 0006 Phase B) --------------------------------------------
# Extraction runs only when the selected provider is configured. No fallback.
# ANALYSIS_DAILY_BUDGET=50
# ANALYSIS_TIMEOUT_SECONDS=300
# ANALYSIS_MAX_BODY_CHARS=20000

# LM Studio or another OpenAI-compatible server:
# ANALYSIS_PROVIDER=openai_compatible
# OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
# OPENAI_COMPAT_MODEL=qwen/qwen3.8-27b
# Only if the server requires one. A hosted endpoint receives article text.
# OPENAI_COMPAT_API_KEY=

# Ollama:
# ANALYSIS_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=
